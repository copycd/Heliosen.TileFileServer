{
  "Logging": {
    "LogLevel": {
      "Default": "Information",

      // 이걸 Information 으로 두면 요청마다 "Request starting / finished" 두 줄이 찍힌다.
      // 초당 수천 요청을 받는 타일 서버에서는 그 로깅 자체가 가장 큰 병목이 된다.
      // nginx 의 access_log off 에 해당한다.
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:7080"
      }
    }
  },

  "AllowedHosts": "*",

  "TileServer": {
    // 이 폴더 밑의 폴더 하나가 URL 첫 조각 하나가 된다.
    //   {Root}/aaa  ->  http://localhost:7080/aaa/12/345/4455.jpg
    //   {Root}/bbb  ->  http://localhost:7080/bbb/4/222/5555.terrain
    "Root": "tiles",

    // 레이어 이름이 가질 수 있는 폴더 깊이.
    //   1 -> {Root}/aaa          => /aaa/12/345/4455.jpg
    //   3 -> {Root}/korea/seoul  => /korea/seoul/12/345/4455.jpg
    // RocksDB 폴더는 이 깊이까지 자동으로 찾아 들어간다(DB 안으로는 들어가지 않는다).
    // 파일 폴더는 RocksDB 가 없는 가지에서 가장 얕은 곳이 레이어가 된다.
    "MaxLayerDepth": 3,

    "RescanSeconds": 30,
    "WatchFileSystem": true,

    "BlockCacheMB": 512,
    "MaxOpenFilesPerDb": 256,
    "NegativeCacheEntries": 100000,

    "CacheMaxAgeSeconds": 3600,
    "CacheImmutable": false,

    "ExtensionFallback": true,
    "VerifyChecksums": true,

    "OpenRetrySeconds": 30,
    "WarmupOnStart": true,
    "RetireGraceSeconds": 10,

    "IgnoreFolders": [],

    "EnableCors": true,
    "AllowedOrigins": [],

    "EnableAdmin": true,
    "AdminToken": null
  }
}
