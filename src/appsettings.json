{
  "Logging": {
    "LogLevel": {
      "Default": "Information",

      // 이걸 Information 으로 두면 요청마다 "Request starting / finished" 두 줄이 찍힌다.
      // 초당 수천 요청을 받는 타일 서버에서는 그 로깅 자체가 가장 큰 병목이 된다.
      // nginx 의 access_log off 에 해당한다.
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:7080"
      }
    }
  },

  "AllowedHosts": "*",

  "TileServer": {
    // 이 폴더 밑의 폴더 하나가 URL 첫 조각 하나가 된다.
    //   {Root}/aaa  ->  http://localhost:7080/aaa/12/345/4455.jpg
    //   {Root}/bbb  ->  http://localhost:7080/bbb/4/222/5555.terrain
    "Root": "tiles",

    // RocksDB 폴더를 찾아 들어갈 최대 깊이 (1~4).
    //   1 -> {Root}/aaa          => /aaa/12/345/4455.jpg
    //   3 -> {Root}/korea/seoul  => /korea/seoul/12/345/4455.jpg
    // 파일은 목록에 담지 않으므로 이 값과 무관하다. URL 이 곧 파일 경로다.
    "MaxLayerDepth": 3,

    // RocksDB 목록을 다시 훑는 주기(초). 파일은 훑지 않는다.
    "RescanSeconds": 60,
    "WatchFileSystem": true,

    "BlockCacheMB": 512,
    "MaxOpenFilesPerDb": 256,
    "NegativeCacheEntries": 100000,

    "CacheMaxAgeSeconds": 3600,
    "CacheImmutable": false,

    // 압축 안 된 채로 저장된 terrain 타일을 gzip 으로 응답한다(Accept-Encoding 과 무관하게 항상).
    // DB 에 이미 gzip 으로 저장된 타일은 다시 압축하지 않고 그대로 나간다.
    "GzipTerrain": true,

    // 레이어별로 따로 정한다. 키는 URL 의 레이어 이름(korea/seoul 처럼), 값은 true/false.
    //   true  -> jpg/png 가 아닌 타일을 gzip 으로 응답
    //   false -> 압축하지 않음
    // 여기 없는 레이어는 GzipTerrain 을 따른다.
    //   예) "GzipLayers": { "bbb": false, "korea/busan": true }
    "GzipLayers": {},

    // 응답할 때 압축한 타일을 들고 있을 메모리 상한(MB). 모든 레이어가 함께 쓴다. 0 이면 캐시 없이 매번 압축한다.
    "GzipCacheMB": 256,

    "ExtensionFallback": true,
    "VerifyChecksums": true,

    "OpenRetrySeconds": 30,
    "WarmupOnStart": true,
    "RetireGraceSeconds": 10,

    "IgnoreFolders": [],

    "EnableCors": true,
    "AllowedOrigins": [],

    "EnableAdmin": true,
    "AdminToken": null
  }
}
